        '个索引未优化': {'zh-TW': '個索引未優化', 'en-US': ' indices not optimized', 'ja-JP': 'インデックスが最適化されていない'},
        '已配置': {'zh-TW': '已配置', 'en-US': 'Configured', 'ja-JP': '設定済み'},
        'mapping 字段合理': {'zh-TW': 'mapping 欄位合理', 'en-US': 'Mapping fields reasonable', 'ja-JP': 'マッピングフィールドが適切'},
        'mapping 字符串类型设定合理': {'zh-TW': 'mapping 字串類型設定合理', 'en-US': 'Mapping string type settings reasonable', 'ja-JP': 'マッピング文字列タイプ設定が適切'},
        '所有索引段数均在合理范围': {'zh-TW': '所有索引段數均在合理範圍', 'en-US': 'All indices have segment count within reasonable range', 'ja-JP': 'すべてのインデックスのセグメント数が適切な範囲内'},
        '个索引段数过高': {'zh-TW': '個索引段數過高', 'en-US': ' indices have excessive segment count', 'ja-JP': 'インデックスのセグメント数が高すぎる'},
        '段数过高': {'zh-TW': '段數過高', 'en-US': ' segment count too high', 'ja-JP': 'セグメント数が高すぎる'},
    }
    
    translated = message
    
    # 按长度降序替换，确保长模式优先匹配
    sorted_phrases = sorted(common_phrases.keys(), key=len, reverse=True)
    for cn_phrase in sorted_phrases:
        if cn_phrase in translated:
            lang_map = common_phrases[cn_phrase]
            replacement = lang_map.get(lang, cn_phrase)
            translated = translated.replace(cn_phrase, replacement)
    
    # 特殊处理：数字模式的翻译
    if lang == 'en-US':
        # 处理 "X个节点" 模式
        translated = re.sub(r'(\d+)個?节点', r'\1 node(s)', translated)
        # 处理 "X亿" 模式
        translated = re.sub(r'(\d+)亿', r'\100M', translated)
        
        # 智能添加空格：在英文字母和中文之间添加空格
        translated = re.sub(r'([a-zA-Z])([\u4e00-\u9fff])', r'\1 \2', translated)
        translated = re.sub(r'([\u4e00-\u9fff])([a-zA-Z])', r'\1 \2', translated)
        
        # 在连续的英文单词之间添加空格（如果它们紧贴在一起）
        # 匹配小写字母/右括号后紧跟大写字母的情况
        translated = re.sub(r'([a-z)])([A-Z])', r'\1 \2', translated)
        # 匹配多个大写字母后紧跟小写字母的情况（如 "Oversizedshard" -> "Oversized shard"）
        translated = re.sub(r'([A-Z]+)([A-Z][a-z])', lambda m: m.group(1) + ' ' + m.group(2) if len(m.group(1)) > 1 else m.group(0), translated)
        
        # 清理多余空格（将多个连续空格替换为单个空格）
        translated = re.sub(r'\s{2,}', ' ', translated).strip()
    elif lang == 'zh-TW':
        # 简体转繁体（补充）
        translated = translated.replace('节点', '節點').replace('线程', '執行緒')
    elif lang == 'ja-JP':
        # 处理数字+量词
        translated = re.sub(r'(\d+)個?节点', r'\1ノード', translated)
    
    return translated
