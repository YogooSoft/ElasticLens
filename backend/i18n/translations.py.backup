def translate(key: str, lang: str = 'zh-CN') -> str:
    """
    获取翻译文本
    
    Args:
        key: 翻译键
        lang: 语言代码 (zh-CN, zh-TW, en-US)
        
    Returns:
        翻译后的文本，如果找不到则返回键本身
    """
    # 验证语言
    if lang not in TRANSLATIONS:
        lang = 'zh-CN'  # fallback to Chinese
    
    # 获取翻译
    translation = TRANSLATIONS[lang].get(key)
    
    # 如果找不到，尝试fallback到中文
    if translation is None:
        translation = TRANSLATIONS['zh-CN'].get(key, key)
    
    return translation


def get_supported_languages() -> list:
    """获取支持的语言列表"""
    return list(TRANSLATIONS.keys())


def translate_check_message(message: str, lang: str = 'zh-CN') -> str:
    """
    智能翻译检查项的message字段
    
    策略：
    1. 如果message包含已知的中文模式，尝试翻译
    2. 使用正则表达式处理动态内容（数字、节点名、索引名等）
    3. 对常见短语进行逐词翻译
    4. 否则返回原文本（可能是已经是目标语言）
    
    Args:
        message: 原始消息文本
        lang: 目标语言
        
    Returns:
        翻译后的消息
    """
    if not message or lang == 'zh-CN':
        return message
    
    import re
    # 常见模式的翻译映射
    translations_map = {
        '集群状态：': {
            'zh-TW': '叢集狀態：',
