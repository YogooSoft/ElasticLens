            'en-US': 'None',
            'ja-JP': 'なし'
        },
        '总次数': {
            'zh-TW': '總次數',
            'en-US': 'Total Count',
            'ja-JP': '総回数'
        },
        # 检查项说明文本翻译
        '所有索引的 mapping 字段数是否过多（>100）': {
            'zh-TW': '所有索引的 mapping 欄位數是否過多（>100）',
            'en-US': 'Whether any index has excessive mapping fields (>100)',
            'ja-JP': 'すべてのインデックスのmappingフィールド数が多すぎるか（>100）'
        },
        '所有索引的字符串类型字段是否采用的默认设定，即 text + keyword 的组合': {
            'zh-TW': '所有索引的字串類型欄位是否採用預設設定，即 text + keyword 的組合',
            'en-US': 'Whether string type fields use default settings (text + keyword combination)',
            'ja-JP': 'すべてのインデックスの文字列タイプフィールドがデフォルト設定（text + keywordの組み合わせ）を使用しているか'
        }
    }
    
    # 尝试匹配并替换（按长度降序，确保更长的模式优先匹配）
    translated = message
    sorted_patterns = sorted(translations_map.keys(), key=len, reverse=True)
    for cn_pattern in sorted_patterns:
        lang_map = translations_map[cn_pattern]
        if cn_pattern in translated:
            replacement = lang_map.get(lang, cn_pattern)
            translated = translated.replace(cn_pattern, replacement)
    
    # 特殊处理：替换 "数字+个索引" 模式
    if lang == 'en-US':
        translated = re.sub(r'(\d+)个索引', r'\1 indices', translated)
        translated = re.sub(r'(\d+)个节点', r'\1 nodes', translated)
        translated = re.sub(r'(\d+)亿', r'\100M', translated)
    elif lang == 'zh-TW':
        translated = re.sub(r'(\d+)个索引', r'\1個索引', translated)
        translated = re.sub(r'(\d+)个节点', r'\1個節點', translated)
    elif lang == 'ja-JP':
        translated = re.sub(r'(\d+)个索引', r'\1インデックス', translated)
        translated = re.sub(r'(\d+)个节点', r'\1ノード', translated)
        translated = re.sub(r'(\d+)亿', r'\1億', translated)
    
    # 新增：智能处理动态生成的告警消息
    # 如果翻译后仍然包含中文，尝试逐词翻译常见短语
    if lang != 'zh-CN' and _contains_chinese(translated):
        translated = _translate_dynamic_message(translated, lang)
    
    return translated


def _contains_chinese(text: str) -> bool:
    """检查文本是否包含中文字符"""
    import re
    return bool(re.search(r'[\u4e00-\u9fff]', text))


def _translate_dynamic_message(message: str, lang: str) -> str:
    """
    智能翻译动态生成的消息（处理未预定义的模式）
    
    Args:
        message: 原始消息
        lang: 目标语言
        
    Returns:
        翻译后的消息
    """
    import re
    
    # 通用短语翻译映射（覆盖更多场景）
    common_phrases = {
        # 状态相关
        '集群状态为': {'zh-TW': '叢集狀態為', 'en-US': 'Cluster status is', 'ja-JP': 'クラスタステータス：'},
        '运行正常': {'zh-TW': '運行正常', 'en-US': 'running normally', 'ja-JP': '正常に動作中'},
        '主分片未分配': {'zh-TW': '主分片未分配', 'en-US': 'primary shards unassigned', 'ja-JP': 'プライマリシャード未割り当て'},
        '数据不可用': {'zh-TW': '資料不可用', 'en-US': 'data unavailable', 'ja-JP': 'データ利用不可'},
        '副本分片未分配': {'zh-TW': '副本分片未分配', 'en-US': 'replica shards unassigned', 'ja-JP': 'レプリカシャード未割り当て'},
        
        # 分片相关
        '分片': {'zh-TW': '分片', 'en-US': 'shard(s)', 'ja-JP': 'シャード'},
        '主分片': {'zh-TW': '主分片', 'en-US': 'primary shard(s)', 'ja-JP': 'プライマリシャード'},
        '副本分片': {'zh-TW': '副本分片', 'en-US': 'replica shard(s)', 'ja-JP': 'レプリカシャード'},
        '未分配分片': {'zh-TW': '未分配分片', 'en-US': 'unassigned shards', 'ja-JP': '未割り当てシャード'},
        '超大': {'zh-TW': '超大', 'en-US': 'Oversized', 'ja-JP': '過大'},
        '过大': {'zh-TW': '過大', 'en-US': 'Oversized', 'ja-JP': '過大'},
        '数量': {'zh-TW': '數量', 'en-US': 'Count', 'ja-JP': '数'},
        '分片正常': {'zh-TW': '分片正常', 'en-US': 'Shards normal', 'ja-JP': 'シャード正常'},
        '标准差': {'zh-TW': '標準差', 'en-US': 'Std Dev', 'ja-JP': '標準偏差'},
        '分布': {'zh-TW': '分佈', 'en-US': 'Distribution', 'ja-JP': '分布'},
        '均衡': {'zh-TW': '均衡', 'en-US': 'Balanced', 'ja-JP': '均等'},
        '不均': {'zh-TW': '不均', 'en-US': 'Unbalanced', 'ja-JP': '不均等'},
        
        # 数量描述
        '存在': {'zh-TW': '存在', 'en-US': 'Found', 'ja-JP': '存在する'},
        '个': {'zh-TW': '個', 'en-US': '', 'ja-JP': '個'},
        '低于': {'zh-TW': '低於', 'en-US': 'below', 'ja-JP': '以下'},
        '高于': {'zh-TW': '高於', 'en-US': 'above', 'ja-JP': '以上'},
        '超过': {'zh-TW': '超過', 'en-US': 'exceeds', 'ja-JP': '超える'},
        
        # 检查项
        '正在初始化': {'zh-TW': '正在初始化', 'en-US': 'initializing', 'ja-JP': '初期化中'},
        '正在迁移': {'zh-TW': '正在遷移', 'en-US': 'relocating', 'ja-JP': '再配置中'},
        '未分配': {'zh-TW': '未分配', 'en-US': 'unassigned', 'ja-JP': '未割り当て'},
        '延迟未分配': {'zh-TW': '延遲未分配', 'en-US': 'delayed unassigned', 'ja-JP': '遅延未割り当て'},
        
        # 节点相关
        '节点': {'zh-TW': '節點', 'en-US': 'node(s)', 'ja-JP': 'ノード'},
        '的': {'zh-TW': '的', 'en-US': "'", 'ja-JP': 'の'},
        '线程池': {'zh-TW': '執行緒池', 'en-US': 'thread pool', 'ja-JP': 'スレッドプール'},
        '存在拒绝': {'zh-TW': '存在拒絕', 'en-US': 'has rejections', 'ja-JP': '拒否あり'},
        '部分节点存在拒绝，详见详情': {'zh-TW': '部分節點存在拒絕，詳見詳情', 'en-US': 'Some nodes have rejections, see details', 'ja-JP': '一部のノードで拒否が発生、詳細を参照'},
        
        # GC相关
        '所有节点GC情况：': {'zh-TW': '所有節點GC情況：', 'en-US': 'GC status for all nodes: ', 'ja-JP': '全ノードのGC状況：'},
        '不存在GC异常': {'zh-TW': '不存在GC異常', 'en-US': 'No GC anomalies detected', 'ja-JP': 'GC異常なし'},
        '个节点Old Gen使用率过高': {'zh-TW': '個節點Old Gen使用率過高', 'en-US': ' nodes with high Old Gen usage', 'ja-JP': 'ノードのOld Gen使用率が高い'},
        '使用率过高': {'zh-TW': '使用率過高', 'en-US': 'usage too high', 'ja-JP': '使用率が高すぎます'},
        
        # Swap相关
        '服务器swap分区检查：': {'zh-TW': '伺服器swap分區檢查：', 'en-US': 'Server swap partition check: ', 'ja-JP': 'サーバーSWAPパーティションチェック：'},
        '所有节点服务器均已禁用swap交换分区': {'zh-TW': '所有節點伺服器均已禁用swap交換分區', 'en-US': 'All nodes have swap partition disabled', 'ja-JP': '全ノードでSWAPが無効'},
        '个节点未禁用swap': {'zh-TW': '個節點未禁用swap', 'en-US': ' nodes have swap enabled', 'ja-JP': 'ノードでSWAPが有効'},
