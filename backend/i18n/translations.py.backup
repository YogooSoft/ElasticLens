        '副本数为 0': {'zh-TW': '副本數為 0', 'en-US': 'have replica count of 0', 'ja-JP': 'レプリカ数が0'},
        '副本数为': {'zh-TW': '副本數為', 'en-US': ' replica count is', 'ja-JP': 'レプリカ数は'},
